{
  "spinner in a line of text": {
    "light": {
      ".vp-spinner": {
        "display": "inline-block",
        "width": "18px",
        "block-size": "18px",
        "border-top-color": "rgb(52, 81, 178)",
        "border-right-color": "rgb(226, 226, 227)",
        "border-bottom-color": "rgb(226, 226, 227)",
        "border-left-color": "rgb(226, 226, 227)"
      }
    },
    "dark": {
      ".vp-spinner": {
        "display": "inline-block",
        "width": "18px",
        "block-size": "18px",
        "border-top-color": "rgb(168, 177, 255)",
        "border-right-color": "rgb(46, 46, 50)",
        "border-bottom-color": "rgb(46, 46, 50)",
        "border-left-color": "rgb(46, 46, 50)"
      }
    }
  },
  "spinner examples": {
    "light": {
      "span.vp-spinner[role=\"status\"]": {
        "display": "inline-block",
        "width": "18px",
        "block-size": "18px",
        "border-top-color": "rgb(52, 81, 178)",
        "border-right-color": "rgb(226, 226, 227)",
        "border-bottom-color": "rgb(226, 226, 227)",
        "border-left-color": "rgb(226, 226, 227)"
      },
      ".vp-btn > .vp-spinner": {
        "width": "16px",
        "block-size": "16px",
        "border-top-color": "rgb(255, 255, 255)",
        "border-right-color": "color(srgb 1 1 1 / 0.3)",
        "border-bottom-color": "color(srgb 1 1 1 / 0.3)",
        "border-left-color": "color(srgb 1 1 1 / 0.3)"
      }
    },
    "dark": {
      "span.vp-spinner[role=\"status\"]": {
        "display": "inline-block",
        "width": "18px",
        "block-size": "18px",
        "border-top-color": "rgb(168, 177, 255)",
        "border-right-color": "rgb(46, 46, 50)",
        "border-bottom-color": "rgb(46, 46, 50)",
        "border-left-color": "rgb(46, 46, 50)"
      },
      ".vp-btn > .vp-spinner": {
        "width": "16px",
        "block-size": "16px",
        "border-top-color": "rgb(255, 255, 255)",
        "border-right-color": "color(srgb 1 1 1 / 0.3)",
        "border-bottom-color": "color(srgb 1 1 1 / 0.3)",
        "border-left-color": "color(srgb 1 1 1 / 0.3)"
      }
    }
  },
