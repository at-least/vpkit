        "height": "20px"
      },
      ".vp-icon-btn[data-size=\"sm\"] > svg": {
        "width": "20px",
        "height": "20px",
        "offset-top": "8px",
        "offset-left": "8px"
      },
      ".vp-btn": {
        "height": "44px"
      },
      ".vp-btn[data-size=\"sm\"]": {
        "height": "36px"
      }
    }
  },
