  "icon-btn examples": {
    "light": {
      ".vp-icon-btn": {
        "width": "44px",
        "height": "44px",
        "color": "rgb(103, 103, 108)",
        "background-color": "rgba(0, 0, 0, 0)",
        "border-top-color": "rgb(103, 103, 108)",
        "border-right-color": "rgb(103, 103, 108)",
        "border-bottom-color": "rgb(103, 103, 108)",
        "border-left-color": "rgb(103, 103, 108)"
      },
      ".vp-icon-btn > svg": {
        "width": "20px",
        "height": "20px",
        "fill": "none",
        "stroke": "rgb(103, 103, 108)",
        "offset-top": "12px",
        "offset-left": "12px"
      },
      "a.vp-icon-btn > svg": {
        "fill": "rgb(103, 103, 108)",
        "stroke": "none"
      }
    },
    "dark": {
      ".vp-icon-btn": {
        "width": "44px",
        "height": "44px",
        "color": "rgb(152, 152, 159)",
        "background-color": "rgba(0, 0, 0, 0)",
        "border-top-color": "rgb(152, 152, 159)",
        "border-right-color": "rgb(152, 152, 159)",
        "border-bottom-color": "rgb(152, 152, 159)",
        "border-left-color": "rgb(152, 152, 159)"
      },
      ".vp-icon-btn > svg": {
        "width": "20px",
        "height": "20px",
        "fill": "none",
        "stroke": "rgb(152, 152, 159)",
        "offset-top": "12px",
        "offset-left": "12px"
      },
      "a.vp-icon-btn > svg": {
        "fill": "rgb(152, 152, 159)",
        "stroke": "none"
      }
    }
  },
  "icon-btn with a stroke svg": {
    "light": {
      "svg": {
        "fill": "none"
      }
    },
    "dark": {
      "svg": {
        "fill": "none"
      }
    }
  },
  "icon-btn sizes": {
    "light": {
      ".vp-icon-btn": {
        "width": "44px",
        "height": "44px"
      },
      ".vp-icon-btn[data-size=\"sm\"]": {
        "width": "36px",
        "height": "36px"
      },
      ".vp-icon-btn > svg": {
        "width": "20px",
        "height": "20px"
      },
      ".vp-icon-btn[data-size=\"sm\"] > svg": {
        "width": "20px",
        "height": "20px",
        "offset-top": "8px",
        "offset-left": "8px"
      },
      ".vp-btn": {
        "height": "44px"
      },
      ".vp-btn[data-size=\"sm\"]": {
        "height": "36px"
      }
    },
    "dark": {
      ".vp-icon-btn": {
