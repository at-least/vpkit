  "divider with a label": {
    "light": {
      ".vp-divider": {
        "display": "flex",
        "align-items": "center",
        "column-gap": "12px",
        "font-size": "13px",
        "line-height": "20px",
        "color": "rgb(103, 103, 108)",
        "margin-top": "16px",
        "margin-right": "0px",
        "margin-bottom": "16px",
        "margin-left": "0px",
        "border-top-width": "0px",
        "border-right-width": "0px",
        "border-bottom-width": "0px",
        "border-left-width": "0px",
        "height": "20px"
      },
      ".vp-divider::before": {
        "block-size": "1px",
        "flex-grow": "1",
        "flex-shrink": "1",
        "border-top-width": "1px",
        "border-top-style": "solid",
        "border-top-color": "rgb(226, 226, 227)",
        "background-color": "rgba(0, 0, 0, 0)"
      },
      ".vp-divider::after": {
        "block-size": "1px",
        "flex-grow": "1",
        "flex-shrink": "1",
        "border-top-width": "1px",
        "border-top-style": "solid",
        "border-top-color": "rgb(226, 226, 227)",
        "background-color": "rgba(0, 0, 0, 0)"
      }
    },
    "dark": {
      ".vp-divider": {
        "display": "flex",
        "align-items": "center",
