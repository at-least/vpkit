{
  "divider between paragraphs": {
    "light": {
      ".vp-divider": {
        "margin-top": "16px",
        "margin-right": "0px",
        "margin-bottom": "16px",
        "margin-left": "0px",
        "border-top-width": "1px",
        "border-top-style": "solid",
        "border-right-width": "0px",
        "border-right-style": "none",
        "border-bottom-width": "0px",
        "border-bottom-style": "none",
        "border-left-width": "0px",
        "border-left-style": "none",
        "border-top-color": "rgb(226, 226, 227)",
        "border-right-color": "rgb(60, 60, 67)",
        "border-bottom-color": "rgb(60, 60, 67)",
        "border-left-color": "rgb(60, 60, 67)",
        "width": "1280px",
        "height": "1px",
        "background-color": "rgba(0, 0, 0, 0)",
        "offset-top": "40px"
      },
      ".vp-divider + p": {
        "offset-top": "57px"
      }
    },
    "dark": {
      ".vp-divider": {
        "margin-top": "16px",
        "margin-right": "0px",
        "margin-bottom": "16px",
