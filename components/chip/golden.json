        "height": "26px"
      },
      ".vp-chip-remove :hover": {
        "color": "rgb(223, 223, 214)"
      },
      ".vp-chip-remove > svg": {
        "width": "16px",
        "height": "16px"
      }
    }
  },
  "chip remove focused": {
    "light": {
      ".vp-chip-remove :focus-visible": {
        "outline-width": "2px",
        "outline-style": "solid",
        "outline-color": "rgb(52, 81, 178)",
        "outline-offset": "2px"
      }
    },
    "dark": {
      ".vp-chip-remove :focus-visible": {
        "outline-width": "2px",
        "outline-style": "solid",
        "outline-color": "rgb(168, 177, 255)",
        "outline-offset": "2px"
      }
    }
  },
  "chip remove on a touch screen, the hit area": {
    "light": {
      ".vp-chip-remove": {
        "margin-top": "-7px",
