{
  "tabs tab focused": {
    "light": {
      ".vp-tabs-tab[aria-selected=\"false\"] :focus-visible": {
        "outline-width": "2px",
        "outline-style": "solid",
        "outline-color": "rgb(52, 81, 178)",
        "outline-offset": "-2px"
      }
    },
    "dark": {
      ".vp-tabs-tab[aria-selected=\"false\"] :focus-visible": {
        "outline-width": "2px",
        "outline-style": "solid",
        "outline-color": "rgb(168, 177, 255)",
        "outline-offset": "-2px"
      }
    }
  }
}
