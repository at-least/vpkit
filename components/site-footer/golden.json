{
  "site-footer": {
    "light": {
      ".vp-site-footer": {
        "z-index": "auto"
      }
    },
    "dark": {
      ".vp-site-footer": {
        "z-index": "auto"
      }
    }
  },
  "site-footer at a phone's width": {
    "light": {
      ".vp-site-footer": {
        "z-index": "auto"
      }
    },
    "dark": {
      ".vp-site-footer": {
        "z-index": "auto"
      }
    }
  },
  "site-footer message": {
    "light": {
      ".vp-site-footer": {
        "height": "89px",
        "border-top-color": "rgb(226, 226, 227)",
        "background-color": "rgb(255, 255, 255)"
      },
      "p": {
        "color": "rgb(103, 103, 108)",
        "font-size": "14px",
        "text-align": "center"
      },
      "a": {
        "color": "rgb(103, 103, 108)",
        "text-decoration-line": "underline"
      }
    },
    "dark": {
      ".vp-site-footer": {
        "height": "89px",
        "border-top-color": "rgb(0, 0, 0)",
        "background-color": "rgb(27, 27, 31)"
      },
      "p": {
        "color": "rgb(152, 152, 159)",
        "font-size": "14px",
        "text-align": "center"
      },
      "a": {
        "color": "rgb(152, 152, 159)",
        "text-decoration-line": "underline"
      }
    }
  }
}
