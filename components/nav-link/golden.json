        "offset-left": "0px"
      },
      ".vp-nav-link + .vp-nav-link": {
        "offset-left": "94px"
      }
    }
  },
  "nav-link lane link on a touch screen": {
    "light": {
      ".vp-nav-link": {
        "min-height": "36px",
        "padding-top": "0px",
        "padding-right": "12px",
        "padding-bottom": "0px",
        "padding-left": "12px",
        "height": "36px"
      }
    },
    "dark": {
