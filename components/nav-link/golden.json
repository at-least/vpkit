        "padding-bottom": "0px",
        "padding-left": "12px",
        "height": "36px"
      }
    }
  },
  "nav-link lane link focused": {
    "light": {
      ".vp-nav-link :focus-visible": {
        "outline-width": "2px",
        "outline-style": "solid",
        "outline-color": "rgb(52, 81, 178)",
        "outline-offset": "-2px"
      }
    },
    "dark": {
      ".vp-nav-link :focus-visible": {
        "outline-width": "2px",
        "outline-style": "solid",
        "outline-color": "rgb(168, 177, 255)",
        "outline-offset": "-2px"
      }
    }
  }
