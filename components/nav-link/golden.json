{
  "nav-link bar example": {
    "light": {
      ".vp-nav-link[aria-current=\"page\"]": {
        "color": "rgb(52, 81, 178)",
        "height": "64px"
      },
      "a.vp-nav-link:not([aria-current])": {
        "color": "rgb(60, 60, 67)",
        "height": "64px",
        "offset-top": "64px"
      },
      "button.vp-nav-link": {
        "color": "rgb(60, 60, 67)",
        "height": "64px",
        "font-size": "14px",
        "font-weight": "500"
      }
    },
    "dark": {
      ".vp-nav-link[aria-current=\"page\"]": {
        "color": "rgb(168, 177, 255)",
        "height": "64px"
      },
      "a.vp-nav-link:not([aria-current])": {
        "color": "rgb(223, 223, 214)",
        "height": "64px",
        "offset-top": "64px"
      },
      "button.vp-nav-link": {
        "color": "rgb(223, 223, 214)",
        "height": "64px",
        "font-size": "14px",
        "font-weight": "500"
      }
    }
  },
  "nav-link screen example": {
    "light": {
      ".vp-nav-link[aria-current=\"page\"]": {
        "color": "rgb(52, 81, 178)",
        "height": "48px",
        "border-bottom-color": "rgb(226, 226, 227)"
      },
      ".vp-nav-link + .vp-nav-link": {
        "color": "rgb(60, 60, 67)",
        "height": "48px",
        "offset-top": "48px"
      }
    },
    "dark": {
      ".vp-nav-link[aria-current=\"page\"]": {
        "color": "rgb(168, 177, 255)",
        "height": "48px",
        "border-bottom-color": "rgb(46, 46, 50)"
      },
      ".vp-nav-link + .vp-nav-link": {
        "color": "rgb(223, 223, 214)",
        "height": "48px",
        "offset-top": "48px"
      }
    }
  },
  "nav-link lane": {
    "light": {
      ".vp-nav-lane": {
        "display": "flex",
        "column-gap": "4px",
        "overflow-x": "auto",
        "overflow-y": "auto",
        "scrollbar-width": "none",
        "mask-image": "none",
        "width": "640px",
        "height": "36px"
      },
      ".vp-nav-link": {
        "min-height": "36px",
        "border-top-left-radius": "6px",
        "border-top-right-radius": "6px",
        "border-bottom-right-radius": "6px",
        "border-bottom-left-radius": "6px",
        "white-space": "nowrap",
        "padding-top": "0px",
        "padding-right": "12px",
        "padding-bottom": "0px",
        "padding-left": "12px",
        "height": "36px",
        "offset-top": "0px",
        "offset-left": "0px"
      },
      ".vp-nav-link + .vp-nav-link": {
        "offset-left": "94px"
      }
    },
    "dark": {
      ".vp-nav-lane": {
        "display": "flex",
        "column-gap": "4px",
        "overflow-x": "auto",
        "overflow-y": "auto",
        "scrollbar-width": "none",
        "mask-image": "none",
        "width": "640px",
        "height": "36px"
      },
      ".vp-nav-link": {
        "min-height": "36px",
        "border-top-left-radius": "6px",
        "border-top-right-radius": "6px",
        "border-bottom-right-radius": "6px",
        "border-bottom-left-radius": "6px",
        "white-space": "nowrap",
        "padding-top": "0px",
        "padding-right": "12px",
        "padding-bottom": "0px",
        "padding-left": "12px",
        "height": "36px",
        "offset-top": "0px",
        "offset-left": "0px"
      },
      ".vp-nav-link + .vp-nav-link": {
        "offset-left": "94px"
      }
    }
  },
  "nav-link lane overflowing": {
    "light": {
      ".vp-nav-lane": {
        "display": "flex",
        "column-gap": "4px",
        "overflow-x": "auto",
        "overflow-y": "auto",
        "scrollbar-width": "none",
        "mask-image": "linear-gradient(90deg, rgba(0, 0, 0, 0) 0px, rgb(0, 0, 0) 16px, rgb(0, 0, 0) calc(100% - 12px), rgba(0, 0, 0, 0) 100%)",
        "width": "256px",
        "height": "36px"
      },
      ".vp-nav-link": {
        "min-height": "36px",
