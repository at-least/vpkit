{
  "sponsor example": {
    "light": {
      ".vp-sponsor": {
        "border-top-left-radius": "16px",
        "border-top-right-radius": "16px",
        "border-bottom-right-radius": "16px",
        "border-bottom-left-radius": "16px",
        "overflow-x": "hidden",
        "height": "398px"
      },
      ".vp-sponsor-tier": {
        "padding-top": "13px",
        "padding-right": "0px",
        "padding-bottom": "11px",
        "padding-left": "0px",
        "font-size": "14px",
        "font-weight": "600",
        "color": "rgb(103, 103, 108)",
        "background-color": "rgb(246, 246, 247)",
        "height": "45px"
      },
      ".vp-sponsor-grid[data-size=\"big\"] .vp-sponsor-grid-link": {
        "height": "184px"
      },
      ".vp-sponsor-grid[data-size=\"big\"] .vp-sponsor-grid-image": {
        "max-width": "192px",
        "max-height": "56px",
        "filter": "grayscale(1)"
      },
      ".vp-sponsor-grid:not([data-size]) .vp-sponsor-grid-item": {
        "width": "423.984px",
        "background-color": "rgb(246, 246, 247)"
      },
      ".vp-sponsor-grid-item:empty": {
        "width": "423.984px",
        "offset-left": "855.96875px",
        "background-color": "rgb(246, 246, 247)"
      },
      ".vp-sponsor-grid-item:empty :hover": {
        "background-color": "rgb(246, 246, 247)"
      }
    },
    "dark": {
      ".vp-sponsor": {
        "border-top-left-radius": "16px",
        "border-top-right-radius": "16px",
        "border-bottom-right-radius": "16px",
        "border-bottom-left-radius": "16px",
        "overflow-x": "hidden",
        "height": "398px"
      },
      ".vp-sponsor-tier": {
        "padding-top": "13px",
        "padding-right": "0px",
        "padding-bottom": "11px",
        "padding-left": "0px",
        "font-size": "14px",
        "font-weight": "600",
        "color": "rgb(152, 152, 159)",
        "background-color": "rgb(32, 33, 39)",
        "height": "45px"
      },
      ".vp-sponsor-grid[data-size=\"big\"] .vp-sponsor-grid-link": {
        "height": "184px"
      },
      ".vp-sponsor-grid[data-size=\"big\"] .vp-sponsor-grid-image": {
        "max-width": "192px",
        "max-height": "56px",
        "filter": "grayscale(1) invert(1)"
      },
      ".vp-sponsor-grid:not([data-size]) .vp-sponsor-grid-item": {
        "width": "423.984px",
        "background-color": "rgb(32, 33, 39)"
      },
      ".vp-sponsor-grid-item:empty": {
        "width": "423.984px",
        "offset-left": "855.96875px",
        "background-color": "rgb(32, 33, 39)"
      },
      ".vp-sponsor-grid-item:empty :hover": {
        "background-color": "rgb(32, 33, 39)"
      }
    }
  }
}
